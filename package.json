{
  "name": "plane",
  "version": "1.4.2",
  "private": true,
  "description": "Open-source project management that unlocks customer value",
  "license": "AGPL-3.0",
  "repository": "https://github.com/makeplane/plane.git",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=18",
    "dev:packages": "turbo run build --filter=./packages/* --concurrency=4",
    "dev:apps": "turbo run dev --filter=web --filter=admin --filter=space --concurrency=20",
    "dev:local": "pnpm dev:packages && pnpm dev:apps",
    "start": "turbo run start",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist",
    "fix": "turbo run fix",
    "fix:format": "turbo run fix:format",
    "fix:lint": "turbo run fix:lint",
    "check": "turbo run check",
    "check:lint": "turbo run check:lint",
    "check:format": "turbo run check:format",
    "check:types": "turbo run check:types",
    "test:e2e": "pnpm --filter @plane/e2e test",
    "test:e2e:smoke": "pnpm --filter @plane/e2e test:smoke",
    "test:e2e:list": "pnpm --filter @plane/e2e test:list",
    "test:e2e:report": "pnpm --filter @plane/e2e report",
    "report:flake": "node scripts/pln026/flake-report.js",
    "report:perf-diff": "node scripts/pln026/performance-diff.js",
    "gate:release": "node scripts/pln026/release-gate.js",
    "test:load:smoke": "k6 run load-tests/runner.js --env LOAD_SCENARIO=smoke",
    "test:load:average": "k6 run load-tests/runner.js --env LOAD_SCENARIO=average",
    "test:load:stress": "k6 run load-tests/runner.js --env LOAD_SCENARIO=stress",
    "test:load:spike": "k6 run load-tests/runner.js --env LOAD_SCENARIO=spike",
    "test:load:soak": "k6 run load-tests/runner.js --env LOAD_SCENARIO=soak",
    "test:load:verify": "node --test load-tests/verify-summary.test.mjs",
    "test:pln026:mutation": "node scripts/pln026/mutation-check.mjs",
    "seed:e2e": "docker compose exec api python manage.py seed_e2e --workspace e2e --project E2E --reset",
    "seed:load": "docker compose exec -e PLANE_LOAD_ENV=local -e LOAD_ALLOW_LOCAL_STAGING=1 api python manage.py seed_load --workspace load --project Load --identifier LOAD --allow-local-staging",
    "prepare": "husky",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react-doctor": "^0.4.2",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,css,md}": [
      "pnpm exec oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
      "pnpm exec oxlint --fix --deny-warnings"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
